# Separate from WARCON's .env. Never commit tokens or webhook URLs.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# A channel for automated seed calls. Empty disables calls until configured.
SEED_CHANNEL_ID=
# Optional role to notify on a NEW seed call only. No @everyone / repeated edit pings.
SEED_ROLE_ID=
# Optional enhanced status webhook. The bot edits one persistent message.
STATUS_WEBHOOK_URL=

# WARCON web service URL. In the companion Docker Compose service: http://warcon:3000
WARCON_URL=http://localhost:3000
WARCON_API_KEY=
WARCON_ORG_ID=
WARCON_SERVER_ID=
# Create a dedicated reserved-slot group in WARCON, target The Colosseum only, switch it on.
# The bot manages only its own entries in this group and preserves other reserved lists.
WARCON_SLOT_GROUP_ID=
# Prefer immutable Discord role IDs in production, comma-separated. When empty the bot
# resolves these exact names, refusing missing or duplicate names.
DONATOR_ROLE_IDS=
DONATOR_ROLE_NAMES=Donator Tier 1,Donator Tier 2,Donator Tier 3

# Public HTTPS URL of the bot's Steam linking service, behind your reverse proxy.
LINK_ORIGIN=https://link.magnuslegio.com
LINK_PORT=3100
LINK_HOST=127.0.0.1
BOT_DATABASE=data/colosseum.sqlite

COMMUNITY_NAME=Clan Magnus Legio
COMMUNITY_URL=https://magnuslegio.com
SERVER_NAME=The Colosseum
# Public status/leaderboard URLs are optional; leave empty unless those pages are enabled.
PUBLIC_STATUS_URL=
PUBLIC_LEADERBOARD_URL=
SEED_TIMEZONE=America/New_York
SEED_START_HOUR=8
SEED_START_BELOW=20
SEED_STOP_AT=36
# New calls are at least this far apart, even when population repeatedly crosses thresholds.
SEED_COOLDOWN_MINUTES=180
POLL_SECONDS=60
ROLE_SYNC_SECONDS=300
STALE_SECONDS=120
